# =================================================================
# tealus-mcp env サンプル
# =================================================================
# このファイルを `.env` にコピーして値を埋める (.env は .gitignore 済)。
#
# 用途:
#   stdio mode (`node src/index.js` or npx 経由):
#     通常 MCP client (Claude Desktop / Code) が config の env で渡すので
#     .env は不要。手動で `node src/index.js` を試す時の便利機能。
#
#   HTTP mode (`--transport=http`、#264):
#     long-running service として host で運用する時、shell に毎回 export
#     するのが煩雑なので .env で集約推奨。
#
# 優先順: dotenv default = no-override。parent process env が先勝ち、
# .env が後付け、空項目だけ埋める。
# =================================================================

# ---- Tealus 接続 (stdio / HTTP 両方で必要) ----
TEALUS_API_URL=http://localhost:3000
TEALUS_USER_ID=AI_AGENT
TEALUS_PASSWORD=change_me

# 旧名 alias も互換 (どちらか一方で OK):
# TEALUS_BOT_ID=AI_AGENT
# TEALUS_BOT_PASS=change_me

# ---- HTTP transport (#264 Phase 1 alpha、`--transport=http` 時のみ) ----
# JWT_SECRET: Tealus 本体 server / agent-server と **完全に同じ値** にする。
# proxy で pass-through、検証は本 server 側で fail-fast 401。
# JWT_SECRET=

# MCP_HTTP_PORT: HTTP server の listen port (default 3200)。
# tealus 本体 server の MCP_HTTP_PORT と同値、変更時は両方更新。
# MCP_HTTP_PORT=3200

# ---- Optional: Gemini Vision fallback (read_document tool、#233) ----
# scan PDF / image-only PDF を Gemini API で OCR、unset で disable。
# privacy 注意: Gemini free tier は Google が input/output を製品改善利用、
# 社内文書扱う場合は paid billing account 紐付け key 推奨。
# GOOGLE_API_KEY=

# DOCUMENT_VISION_PROVIDER=gemini
# DOCUMENT_VISION_MODEL=gemini-2.5-flash-lite
# DOCUMENT_VISION_MAX_PAGES=20

# ---- Optional: DALL-E 3 (generate_and_send_image tool) ----
# OPENAI_API_KEY=
